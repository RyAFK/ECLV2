# Supabase project connection (safe to expose to the browser — the anon key is
# governed entirely by Postgres row-level security, see supabase/migrations/).
# Get these from the Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The following are used only by the Google Drive sync Edge Function
# (supabase/functions/sync-drive-sheets/), never by the Next.js app or the
# browser. Set them as Supabase Edge Function secrets, not in this file:
#   supabase secrets set GOOGLE_SERVICE_ACCOUNT_JSON='{...}'
#   supabase secrets set GOOGLE_DRIVE_FOLDER_ID=1YtRERWNF2NUmeThWN2pSv93ugIcwSPSX
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase into every Edge Function's environment — do not set them yourself
# and never add them to this file or any NEXT_PUBLIC_ variable.
